# Copy to .env for local development; replace the example credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DB_PATH=./telemetry.db
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
TELEMETRY_KEY=replace-with-a-different-random-key
# Optional: chrome-extension://YOUR_EXTENSION_ID (comma-separated origins)
CORS_ORIGINS=
