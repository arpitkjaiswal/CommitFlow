# Copy to .env; never commit actual secrets. npm start does not load .env automatically.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DB_PATH=/data/telemetry.db
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
TELEMETRY_KEY=replace-with-a-separate-random-key
# Optional: chrome-extension://YOUR_EXTENSION_ID (comma-separated origins)
CORS_ORIGINS=
